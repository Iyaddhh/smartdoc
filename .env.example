# SmartDoc Environment Variables Template

# Application Environment: 'development' or 'production'
APP_ENV=development
POSTGRES_USER=smartdoc
POSTGRES_DB=smartdoc_db
POSTGRES_PASSWORD=changeme_set_a_unique_database_password

# Database Connection String
# For Local Host / Native Windows Dev: postgresql+asyncpg://smartdoc:smartdoc_secret@localhost:5433/smartdoc_db
# For Docker Compose Network: postgresql+asyncpg://smartdoc:smartdoc_secret@db:5432/smartdoc_db
DATABASE_URL=postgresql+asyncpg://smartdoc:smartdoc_secret@db:5432/smartdoc_db

# Security Key (Wajib diganti dengan string acak panjang yang aman di mode production)
JWT_ACCESS_SECRET=changeme_generate_random_secure_secret_key_12345
JWT_ACCESS_EXPIRES_IN=15m
# Rotating refresh sessions and Remember me.
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
TRUST_PROXY=false
FRONTEND_URL=http://127.0.0.1:3001
MAIL_TRANSPORT=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="SmartDoc <noreply@smartdoc.local>"

# Allowed CORS Origins (Dipisahkan tanda koma)
# Tambahkan IP LAN jika ingin menguji dari smartphone (misal: http://192.168.1.50:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage & Categorized Limits
STORAGE_PATH=./storage
MAX_FILE_SIZE_DOCUMENT_MB=35
MAX_FILE_SIZE_PPTX_MB=200
MAX_REQUEST_SIZE_MB=202
MAX_PPTX_UNCOMPRESSED_MB=512
MAX_PPTX_ENTRY_MB=200
MAX_PPTX_ENTRIES=20000
MAX_PPTX_IMAGE_PIXELS=8000000
MAX_FILE_SIZE_PDF_MB=35
MAX_FILE_SIZE_IMAGE_MB=12
MAX_IMAGE_DIMENSION_PX=10000
MAX_PDF_PAGES=50
TEMP_FILE_TTL_HOURS=24
JOB_TIMEOUT_SECONDS=300

# Compression Defaults
COMPRESSION_IMAGE_QUALITY=85
COMPRESSION_PPTX_MODE=balanced
COMPRESSION_IMAGE_DPI=150

# Frontend configuration lives in smartdoc-frontend/.env.local.
# Docker Compose supplies API_INTERNAL_URL as its frontend build argument.
