# SmartDoc frontend - copy this file to .env.local for native local development.
# Next.js forwards /api/* to this server-side URL; the browser uses the same origin.
API_INTERNAL_URL=http://127.0.0.1:8001

# No database credentials, JWT secrets, or SMTP settings belong in frontend env.
# DOCKER_BUILD is set by the Dockerfile, not by this local file.
