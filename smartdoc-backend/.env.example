# SmartDoc backend - local development configuration.
# Copy .env.example to .env. Never commit .env or print its secret values.
# Frontend configuration lives in ../smartdoc-frontend/.env.local.

# APPLICATION & FRONTEND
APP_ENV="development"
FRONTEND_URL="http://127.0.0.1:3001"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:3001,http://localhost:3001"

# POSTGRESQL - native host uses localhost:5433
DATABASE_URL="postgresql+asyncpg://smartdoc:CHANGE_ME_DATABASE_PASSWORD@localhost:5433/smartdoc_db"

# JWT & SESSION LIFETIMES - positive duration with s/m/h/d units
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN="30d"

# AUTH COOKIES - Secure=false for local HTTP; blank Domain means host-only
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_DOMAIN=""

# LOCAL EMAIL - local writes an ignored inbox; SMTP variables apply only to smtp transport
MAIL_TRANSPORT="local"
MAIL_FROM="SmartDoc <noreply@smartdoc.local>"
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025

# STORAGE & FILE SIZE LIMITS - MB
STORAGE_PATH="./storage"
MIN_FREE_DISK_MB=256
# Pending + processing jobs; executing jobs still share 3 processing slots.
MAX_ACTIVE_JOBS_PER_USER=2
MAX_ACTIVE_JOBS_GLOBAL=12
MAX_FILE_SIZE_DOCUMENT_MB=35
MAX_FILE_SIZE_PPTX_MB=200
MAX_FILE_SIZE_PDF_MB=35
MAX_FILE_SIZE_IMAGE_MB=12
MAX_TOTAL_UPLOAD_MB=35
MAX_REQUEST_SIZE_MB=202
MAX_UPLOAD_FILES=50

# DOCUMENT & IMAGE VALIDATION
MAX_PDF_PAGES=50
MAX_PDF_PAGE_EDGE_POINTS=2400
MAX_IMAGE_DIMENSION_PX=10000
MAX_OFFICE_UNCOMPRESSED_MB=128
MAX_OFFICE_ENTRY_MB=32
MAX_PPTX_UNCOMPRESSED_MB=512
MAX_PPTX_ENTRY_MB=200
MAX_OFFICE_ENTRIES=2000
MAX_PPTX_ENTRIES=20000
MAX_PPTX_IMAGE_PIXELS=8000000
MAX_OFFICE_COMPRESSION_RATIO=200

# RATE LIMITS & PROCESSING
API_RATE_LIMIT="120/minute"
PROCESS_RATE_LIMIT="10/minute"
PREVIEW_RATE_LIMIT="20/minute"
TEMP_FILE_TTL_HOURS=24
JOB_TIMEOUT_SECONDS=300
COMPRESSION_IMAGE_QUALITY=85
COMPRESSION_PPTX_MODE=balanced
COMPRESSION_IMAGE_DPI=150

# PROXY - Uvicorn uses CLI flags; this setting is reserved, not an active proxy switch
TRUST_PROXY=false
