# SmartDoc Backend Environment Variables Template

APP_ENV=development

# Database Connection String
# For Local Host: postgresql+asyncpg://smartdoc:smartdoc_secret@localhost:5433/smartdoc_db
# For Docker: postgresql+asyncpg://smartdoc:smartdoc_secret@db:5432/smartdoc_db
DATABASE_URL=postgresql+asyncpg://smartdoc:smartdoc_secret@localhost:5433/smartdoc_db

# JWT access token (gunakan secret acak minimal 32 byte untuk production)
JWT_ACCESS_SECRET=changeme_generate_random_secure_secret_key_12345
JWT_ACCESS_EXPIRES_IN=15m
# Konfigurasi untuk implementasi refresh token / Ingat saya berikutnya.
# Endpoint refresh dan cookie autentikasi belum diterapkan.
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d
# false untuk HTTP lokal; true untuk HTTPS production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Kosong = host-only cookie.
AUTH_COOKIE_DOMAIN=
# Dicatat sebagai konfigurasi; proxy Uvicorn masih diatur pada saat peluncuran.
TRUST_PROXY=false

# Allowed CORS Origins (Pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage & Categorized Limits
STORAGE_PATH=./storage
MAX_FILE_SIZE_DOCUMENT_MB=35
MAX_FILE_SIZE_PDF_MB=35
MAX_FILE_SIZE_IMAGE_MB=12
MAX_IMAGE_DIMENSION_PX=10000
MAX_PDF_PAGES=50
TEMP_FILE_TTL_HOURS=24
JOB_TIMEOUT_SECONDS=300

# Compression Defaults
COMPRESSION_IMAGE_QUALITY=85
COMPRESSION_IMAGE_DPI=150
